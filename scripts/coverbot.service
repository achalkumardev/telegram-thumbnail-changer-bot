[Unit]
Description=Telegram Video Cover / Thumbnail Changer Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/telegram_cover_bot
ExecStart=/home/ubuntu/projects/telegram_cover_bot/venv/bin/python3 -u /home/ubuntu/projects/telegram_cover_bot/src/bot.py
Restart=always
RestartSec=5
StandardOutput=append:/home/ubuntu/projects/telegram_cover_bot/bot.log
StandardError=append:/home/ubuntu/projects/telegram_cover_bot/bot.log

[Install]
WantedBy=multi-user.target
